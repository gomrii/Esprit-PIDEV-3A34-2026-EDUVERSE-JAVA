<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="850.0" prefWidth="1250.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AffichierCoursAdmin">
    <children>
        <VBox prefHeight="850.0" prefWidth="1250.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1250.0" spacing="15.0" style="-fx-background-color: #3C3362; -fx-padding: 0 25;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#goToMenu" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="⬅ Menu" />
                        <Label text="Administration des Cours" textFill="white">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#goToStats" style="-fx-background-color: #F1C40F; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="📊 Statistiques Globales" />
                    </children>
                </HBox>

                <VBox spacing="15.0" style="-fx-padding: 0 25;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="300.0" promptText="🔍 Rechercher par titre..." style="-fx-background-radius: 15; -fx-border-color: #dcdde1; -fx-border-radius: 15;" />

                                <ComboBox fx:id="statusFilter" prefHeight="40.0" prefWidth="140.0" promptText="Statut" style="-fx-background-radius: 15;" />
                                <ComboBox fx:id="levelFilter" prefHeight="40.0" prefWidth="140.0" promptText="Niveau" style="-fx-background-radius: 15;" />
                                <ComboBox fx:id="categoryFilter" prefHeight="40.0" prefWidth="140.0" promptText="Catégorie" style="-fx-background-radius: 15;" />

                                <Button mnemonicParsing="false" onAction="#resetFilters" prefHeight="38.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="🔄 Reset" />
                                <Button mnemonicParsing="false" onAction="#loadTable" prefHeight="38.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;" text="↻ Actualiser" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button mnemonicParsing="false" onAction="#gototcha" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand;" text="chapitres" />
                        <Button mnemonicParsing="false" onAction="#gotoadd" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand;" text="+ Ajouter un Cours" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="table" prefHeight="650.0" prefWidth="1200.0" style="-fx-background-radius: 10; -fx-border-color: #dcdde1; -fx-border-radius: 10;">
                            <columns>
                                <TableColumn fx:id="id" prefWidth="50.0" text="ID" />
                                <TableColumn fx:id="titre" prefWidth="150.0" text="Titre" />
                                <TableColumn fx:id="image" prefWidth="90.0" text="Image" />
                                <TableColumn fx:id="level" prefWidth="100.0" text="Niveau" />
                                <TableColumn fx:id="category" prefWidth="110.0" text="Catégorie" />
                                <TableColumn fx:id="status" prefWidth="100.0" text="Statut" />
                                <TableColumn fx:id="date" prefWidth="120.0" text="Date" />
                                <TableColumn fx:id="descrption" prefWidth="150.0" text="Description" />
                                <TableColumn fx:id="actions" prefWidth="380.0" text="Actions de Gestion" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <VBox.margin>
                        <Insets left="25.0" right="25.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
