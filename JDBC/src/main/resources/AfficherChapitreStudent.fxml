<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>

<HBox prefHeight="750.0" prefWidth="1150.0" style="-fx-background-color: #F8F9FD;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AfficherChapitreStudent">
    <children>
        <VBox prefWidth="320.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="30.0" /></padding>
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-letter-spacing: 1px;" text="CONTENU DU MODULE" textFill="#8E44AD" />
                <Separator />
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="chaptersListContainer" spacing="10.0" style="-fx-background-color: white;" />
                    </content>
                </ScrollPane>
                <Button maxWidth="Infinity" onAction="#handleBack" style="-fx-background-color: #F1F2F6; -fx-text-fill: #2C3E50; -fx-cursor: hand;" text="⬅ Retour aux cours" />
            </children>
        </VBox>

        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
            <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
            <children>
                <VBox spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 20, 0, 0, 10);" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
                    <children>
                        <Label fx:id="contentChapterTitle" text="Sélectionnez une leçon" textFill="#2C3E50" wrapText="true">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Line endX="300.0" stroke="#8E44AD" strokeWidth="3.0" />

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="30.0">
                                    <children>
                                        <HBox fx:id="mediaContainer" spacing="15.0" />

                                        <Label fx:id="chapterContentArea" lineSpacing="6.0" maxWidth="Infinity" textFill="#444444" wrapText="true">
                                            <font><Font size="16.0" /></font>
                                        </Label>

                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Button onAction="#handleGeneratePDF" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="📥 Télécharger en PDF">
                                                    <padding>
                                                        <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
                                                    </padding>
                                                </Button>
                                            </children>
                                            <VBox.margin>
                                                <Insets top="20.0" />
                                            </VBox.margin>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
