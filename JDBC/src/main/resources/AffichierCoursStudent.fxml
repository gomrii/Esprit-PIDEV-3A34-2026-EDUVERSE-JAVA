<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F8F9FD;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AffichierCoursStudent">
    <children>

        <VBox layoutX="40.0" layoutY="28.0" prefHeight="97.0" prefWidth="337.0" spacing="5.0" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="28.0">
            <children>
                <Label text="Catalogue de cours" textFill="#2D3436">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label fx:id="nbCoursLabel" text="Explorez nos formations disponibles" textFill="#858585" />
            </children>
        </VBox>

        <Pane layoutX="40.0" layoutY="100.0" prefHeight="85.0" prefWidth="1020.0" style="-fx-background-color: white; -fx-background-radius: 15;" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0">
            <children>
                <VBox layoutX="25.0" layoutY="15.0" spacing="5.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Niveau" textFill="#636E72" />
                        <ComboBox fx:id="levelFilter" prefHeight="35.0" prefWidth="250.0" promptText="Tous les niveaux" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" />
                    </children>
                </VBox>
            </children>
            <effect>
                <DropShadow blurType="THREE_PASS_BOX" color="#0000001a" height="15.0" radius="7.0" width="15.0" />
            </effect>
        </Pane>

        <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="210.0" spacing="15.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0">
            <children>
                <TextField fx:id="searchField" prefHeight="48.0" prefWidth="850.0" promptText="Rechercher un cours..." style="-fx-background-color: white; -fx-background-radius: 25; -fx-border-color: #E0E0E0; -fx-border-radius: 25; -fx-padding: 0 20;" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="48.0" prefWidth="133.0" style="-fx-background-color: #3C3362; -fx-background-radius: 25; -fx-text-fill: white; -fx-cursor: hand;" text="Rechercher">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" layoutX="40.0" layoutY="280.0" prefHeight="450.0" prefWidth="1020.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="280.0">
            <content>
                <FlowPane fx:id="container" hgap="30.0" style="-fx-padding: 15;" vgap="30.0" />
            </content>
        </ScrollPane>
      <Button layoutX="926.0" layoutY="40.0" mnemonicParsing="false" onAction="#gotomenu" prefHeight="48.0" prefWidth="133.0" style="-fx-background-color: #3C3362; -fx-background-radius: 25; -fx-text-fill: white; -fx-cursor: hand;" text="menu">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>

    </children>
</AnchorPane>

