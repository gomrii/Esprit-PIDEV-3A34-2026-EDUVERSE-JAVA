<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<!--
  RegisterView.fxml — Vue d'inscription

  Équivalent Symfony : templates/security/register.html.twig
  Le fx:controller lie cette vue à RegisterController.java
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.elearning.controller.RegisterController"
      styleClass="login-container"
      spacing="0"
      alignment="TOP_CENTER"
      prefWidth="500" prefHeight="620">

    <!-- En-tête -->
    <VBox styleClass="login-header" alignment="CENTER" spacing="8">
        <padding><Insets top="20" bottom="15"/></padding>
        <Label text="📝 Créer un compte" styleClass="login-logo"/>
        <Label text="Rejoins l'espace e-Learning" styleClass="login-subtitle"/>
    </VBox>

    <!-- Formulaire -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox styleClass="login-form" spacing="14" alignment="TOP_CENTER">
            <padding><Insets top="15" right="50" bottom="10" left="50"/></padding>

            <!-- Message d'erreur global -->
            <Label fx:id="errorLabel" styleClass="error-global" wrapText="true"
                   visible="false" managed="false"/>

            <!-- Message de succès -->
            <Label fx:id="successLabel" text="✅ Inscription réussie ! Redirection vers connexion..." 
                   styleClass="success-message" wrapText="true"
                   visible="false" managed="false"/>

            <!-- Champ Nom complet -->
            <VBox spacing="4">
                <Label text="Nom complet *" styleClass="field-label"/>
                <TextField fx:id="fullNameField" promptText="Ahmed Ben Ali"
                           styleClass="text-field"/>
            </VBox>

            <!-- Champ Email -->
            <VBox spacing="4">
                <Label text="Adresse e-mail *" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="votre@email.tn"
                           styleClass="text-field"/>
            </VBox>

            <!-- Sélection du rôle -->
            <VBox spacing="6">
                <Label text="Qui es-tu ? *" styleClass="field-label"/>
                <HBox spacing="20" fx:id="roleHBox">
                    <RadioButton fx:id="radioEtudiant" text="🎓 Étudiant"
                                 userData="ETUDIANT"
                                 selected="true"/>
                    <RadioButton fx:id="radioEnseignant" text="👨‍🏫 Enseignant"
                                 userData="ENSEIGNANT"/>
                </HBox>
            </VBox>

            <!-- Champ Mot de passe -->
            <VBox spacing="4">
                <Label text="Mot de passe *" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Min 8 chars, 1 MAJ, 1 chiffre, 1 spécial"
                               styleClass="text-field"/>
            </VBox>

            <!-- Champ Confirmer mot de passe -->
            <VBox spacing="4">
                <Label text="Confirmer le mot de passe *" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Répétez le mot de passe"
                               styleClass="text-field"/>
            </VBox>

            <!-- Bouton inscription -->
            <Button fx:id="btnRegister" text="Créer mon compte →"
                    styleClass="btn-primary" maxWidth="Infinity"
                    onAction="#handleRegister"/>

            <!-- Lien vers connexion -->
            <HBox alignment="CENTER" spacing="4">
                <Text text="Déjà inscrit ?" style="-fx-fill: #666; -fx-font-size: 13;"/>
                <Hyperlink text="Se connecter" style="-fx-font-size: 13;" onAction="#allerVersLogin"/>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>
