<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ResetPasswordView.fxml — Réinitialisation du mot de passe
    Controller : com.elearning.controller.ResetPasswordController
    Dimensions : 460 × 520
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elearning.controller.ResetPasswordController"
      styleClass="login-root"
      alignment="CENTER"
      spacing="0">

    <!-- En-tête -->
    <VBox styleClass="login-header" alignment="CENTER" spacing="8">
        <Label text="🔒" style="-fx-font-size: 40px;"/>
        <Label text="Réinitialisation du mot de passe" styleClass="login-title"/>
        <Label fx:id="labelEmail" text="Code envoyé à votre email"
               styleClass="login-subtitle" wrapText="true"/>
    </VBox>

    <!-- Formulaire -->
    <VBox styleClass="login-form" spacing="16" alignment="CENTER">

        <!-- Code reçu -->
        <VBox spacing="5">
            <Label text="CODE DE RÉINITIALISATION" styleClass="login-field-label"/>
            <TextField fx:id="tokenField"
                       promptText="Collez le code reçu par email (ex: a3f7b2...)"
                       styleClass="login-field"
                       maxWidth="Infinity"/>
        </VBox>

        <!-- Nouveau mot de passe -->
        <VBox spacing="5">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="NOUVEAU MOT DE PASSE" styleClass="login-field-label"/>
                <Button text="Générer" onAction="#handleGenererMotDePasse" style="-fx-font-size: 10px; -fx-background-color: #ecf0f1; -fx-padding: 2 6; -fx-cursor: hand;"/>
            </HBox>
            <PasswordField fx:id="newPasswordField"
                           promptText="Nouveau mot de passe"
                           styleClass="login-field"
                           maxWidth="Infinity"/>
            <!-- Indicateur de force -->
            <ProgressBar fx:id="passwordStrengthBar"
                         maxWidth="Infinity" prefHeight="6"
                         progress="0"
                         style="-fx-accent: #e74c3c;"/>
            <Label fx:id="passwordStrengthLabel" text=""
                   style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Confirmation -->
        <VBox spacing="5">
            <Label text="CONFIRMER LE MOT DE PASSE" styleClass="login-field-label"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirmez le nouveau mot de passe"
                           styleClass="login-field"
                           maxWidth="Infinity"/>
        </VBox>

        <!-- Erreur globale -->
        <Label fx:id="errGlobal" text=""
               styleClass="error-inline"
               visible="false" managed="false"
               wrapText="true" maxWidth="340"/>

        <!-- Boutons -->
        <VBox spacing="10">
            <Button fx:id="btnReinitialiser"
                    text="✅ Réinitialiser le mot de passe"
                    onAction="#handleReinitialiser"
                    styleClass="login-btn"
                    maxWidth="Infinity"/>
            <Button text="← Retour"
                    onAction="#handleRetour"
                    styleClass="btn-outline"
                    maxWidth="Infinity"/>
        </VBox>

    </VBox>
</VBox>
