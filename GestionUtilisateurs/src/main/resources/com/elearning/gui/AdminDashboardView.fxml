<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!--
  AdminDashboardView.fxml — Tableau de bord administrateur

  Équivalent Symfony : templates/admin/users/list.html.twig
  Structure : Sidebar gauche + Contenu principal à droite
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.elearning.controller.AdminDashboardController"
            prefWidth="1100" prefHeight="700">

    <!-- ===================== SIDEBAR GAUCHE ===================== -->
    <left>
        <VBox styleClass="sidebar" spacing="0" prefWidth="220">

            <!-- Logo -->
            <VBox styleClass="sidebar-header" alignment="CENTER">
                <padding><Insets top="20" bottom="20"/></padding>
                <ImageView fitHeight="70" preserveRatio="true">
                    <image>
                        <Image url="@/com/elearning/images/logo.png"/>
                    </image>
                </ImageView>
                <Label fx:id="labelNomAdmin" text="Admin" styleClass="sidebar-username">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Label>
            </VBox>

            <!-- Menu -->
            <VBox styleClass="sidebar-menu" spacing="4">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="📊 Tableau de bord" styleClass="sidebar-item sidebar-item-active"/>
                <Label text="👥 Utilisateurs"    styleClass="sidebar-item"/>
                <Label text="📚 Formations"       styleClass="sidebar-item"/>
                <Label text="⚙ Paramètres"       styleClass="sidebar-item"/>
            </VBox>

            <!-- Déconnexion en bas -->
            <VBox VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
                <padding><Insets bottom="20"/></padding>
                <Button text="🚪 Déconnexion" styleClass="btn-logout"
                        maxWidth="Infinity"
                        onAction="#handleDeconnexion"/>
            </VBox>

        </VBox>
    </left>

    <!-- ===================== CONTENU PRINCIPAL ===================== -->
    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- Titre -->
            <Label text="Gestion des Utilisateurs" styleClass="page-title"/>

            <!-- ==== Cartes statistiques ==== -->
            <HBox spacing="15">
                <VBox styleClass="stat-card stat-blue"    spacing="4" alignment="CENTER" prefWidth="150">
                    <Label fx:id="labelTotal"      text="0" styleClass="stat-number"/>
                    <Label text="Total"            styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-green"   spacing="4" alignment="CENTER" prefWidth="150">
                    <Label fx:id="labelEtudiants"  text="0" styleClass="stat-number"/>
                    <Label text="Étudiants"        styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-purple"  spacing="4" alignment="CENTER" prefWidth="150">
                    <Label fx:id="labelEnseignants" text="0" styleClass="stat-number"/>
                    <Label text="Enseignants"      styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-orange"  spacing="4" alignment="CENTER" prefWidth="150">
                    <Label fx:id="labelEnAttente"  text="0" styleClass="stat-number"/>
                    <Label text="En attente"       styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-red"     spacing="4" alignment="CENTER" prefWidth="150">
                    <Label fx:id="labelBloques"    text="0" styleClass="stat-number"/>
                    <Label text="Bloqués"          styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- ==== Barre de recherche et filtres ==== -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="🔍 Rechercher par nom ou email..."
                           styleClass="search-field" prefWidth="280"/>

                <Label text="Rôle :"/>
                <ComboBox fx:id="roleFilter" prefWidth="130"/>

                <Label text="Trier par :"/>
                <ComboBox fx:id="sortColumn" prefWidth="110"/>
                <ComboBox fx:id="sortDirection" prefWidth="80"/>

                <!-- Boutons d'action -->
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" spacing="10">
                    <Button text="➕ Ajouter" styleClass="btn-primary"
                            onAction="#handleAjouter"/>
                    <Button text="✅ Approuver" styleClass="btn-success"
                            onAction="#handleApprouver"/>
                    <Button text="📄 Exporter PDF" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-cursor: hand;"
                            onAction="#handleExporterPDF"/>
                </HBox>
            </HBox>

            <!-- ==== Tableau des utilisateurs ==== -->
            <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS"
                       styleClass="users-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId"        text="ID"        prefWidth="45"/>
                    <TableColumn fx:id="colNom"        text="Nom complet" prefWidth="160"/>
                    <TableColumn fx:id="colEmail"      text="Email"     prefWidth="200"/>
                    <TableColumn fx:id="colRole"       text="Rôle"      prefWidth="100"/>
                    <TableColumn fx:id="colStatut"     text="Statut"    prefWidth="100"/>
                    <TableColumn fx:id="colCreatedAt"  text="Créé le"   prefWidth="90"/>
                    <TableColumn fx:id="colActions"    text="Actions"   prefWidth="260"/>
                </columns>
                <placeholder>
                    <Label text="Aucun utilisateur trouvé." style="-fx-text-fill: #999;"/>
                </placeholder>
            </TableView>

        </VBox>
    </center>

</BorderPane>
