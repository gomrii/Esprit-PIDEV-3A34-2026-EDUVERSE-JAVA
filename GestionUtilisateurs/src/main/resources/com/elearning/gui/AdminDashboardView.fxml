<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<!--
  AdminDashboardView.fxml — Tableau de bord administrateur

  Équivalent Symfony : templates/admin/users/list.html.twig
  Structure : Sidebar gauche + Contenu principal à droite
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.elearning.controller.AdminDashboardController"
            prefWidth="900" prefHeight="600"
            styleClass="main-container">

    <!-- ===================== SIDEBAR GAUCHE ===================== -->
    <left>
        <VBox styleClass="sidebar" spacing="0" prefWidth="220">

            <!-- Logo -->
            <VBox styleClass="sidebar-header" alignment="CENTER">
                <padding><Insets top="20" bottom="20"/></padding>
                <ImageView fitHeight="70" preserveRatio="true">
                    <image>
                        <Image url="@/com/elearning/images/logo.png"/>
                    </image>
                </ImageView>
                <Label fx:id="labelNomAdmin" text="Admin" styleClass="sidebar-username">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Label>
            </VBox>

            <!-- Menu -->
            <VBox styleClass="sidebar-menu" spacing="4">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="📊 Tableau de bord" styleClass="sidebar-item sidebar-item-active"/>
                <Label text="👥 Utilisateurs"    styleClass="sidebar-item"/>
                <Label text="📚 Formations"       styleClass="sidebar-item"/>
                <Label text="⚙ Paramètres"       styleClass="sidebar-item"/>
            </VBox>

            <!-- Déconnexion en bas -->
            <VBox VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
                <padding><Insets bottom="20"/></padding>
                <Button text="🚪 Déconnexion" styleClass="btn-logout"
                        maxWidth="Infinity"
                        onAction="#handleDeconnexion"/>
            </VBox>

        </VBox>
    </left>

    <!-- ===================== CONTENU PRINCIPAL ===================== -->
    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- Titre -->
            <Label text="Gestion des Utilisateurs" styleClass="page-title"/>

            <!-- Cartes de statistiques -->
            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15 20 15 20;">
                <VBox styleClass="stat-card stat-blue" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="👥" style="-fx-font-size: 28px;"/>
                    <Label fx:id="totalUsersLabel" text="0" styleClass="stat-number"/>
                    <Label text="Total utilisateurs" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-green" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="🎓" style="-fx-font-size: 28px;"/>
                    <Label fx:id="studentsLabel" text="0" styleClass="stat-number"/>
                    <Label text="Étudiants" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-purple" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="👨‍🏫" style="-fx-font-size: 28px;"/>
                    <Label fx:id="teachersLabel" text="0" styleClass="stat-number"/>
                    <Label text="Enseignants" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-orange" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="⏳" style="-fx-font-size: 28px;"/>
                    <Label fx:id="pendingLabel" text="0" styleClass="stat-number"/>
                    <Label text="En attente" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card stat-red" alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="🚫" style="-fx-font-size: 28px;"/>
                    <Label fx:id="blockedLabel" text="0" styleClass="stat-number"/>
                    <Label text="Bloqués" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- Barre d'outils : recherche + filtres + actions -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="toolbar-panel" style="-fx-padding: 12 20 12 20;">
                <TextField fx:id="searchField" promptText="🔍 Rechercher par nom ou email..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="roleFilter" promptText="Tous les rôles" styleClass="combo-field"/>
                
                <!-- On garde silencieusement le tri pour ne pas casser la logique du controller s'ils y tiennent,
                     ou si on ne l'affiche pas, le controller pourrait ne pas marcher. Le prompt a supprimé ces combobox.
                     Je les remets en 'HBox' avec un style caché ou je les laisse s'il y a des @FXML correspondants.
                     En fait, je vais les inclure visuellement en plus propre sinon le Controller plantera sur un NullPointerException. -->
                <ComboBox fx:id="sortColumn" promptText="Trier" styleClass="combo-field" prefWidth="100"/>
                <ComboBox fx:id="sortDirection" promptText="Ordre" styleClass="combo-field" prefWidth="80"/>

                <Button text="➕ Ajouter" styleClass="btn-primary" onAction="#handleAjouter"/>
                <Button text="📄 Export PDF" styleClass="btn-pdf" onAction="#handleExportPdf"/>
            </HBox>

            <!-- ==== Tableau des utilisateurs ==== -->
            <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS"
                       styleClass="users-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId"        text="ID"        prefWidth="45"/>
                    <TableColumn fx:id="colNom"        text="Nom complet" prefWidth="160"/>
                    <TableColumn fx:id="colEmail"      text="Email"     prefWidth="200"/>
                    <TableColumn fx:id="colRole"       text="Rôle"      prefWidth="100"/>
                    <TableColumn fx:id="colStatut"     text="Statut"    prefWidth="100"/>
                    <TableColumn fx:id="colCreatedAt"  text="Créé le"   prefWidth="90"/>
                    <TableColumn fx:id="colActions"    text="Actions"   prefWidth="260"/>
                </columns>
                <placeholder>
                    <Label text="Aucun utilisateur trouvé." style="-fx-text-fill: #999;"/>
                </placeholder>
            </TableView>

        </VBox>
    </center>

</BorderPane>
