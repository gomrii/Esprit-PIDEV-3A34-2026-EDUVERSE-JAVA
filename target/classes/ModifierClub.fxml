<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ModifierClubController">
    <padding> <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /> </padding>

    <Label text="Sélectionnez le Club à Modifier">
        <font> <Font name="System Bold" size="20.0" /> </font>
    </Label>

    <TableView fx:id="tvClubs" prefHeight="150.0" prefWidth="760.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="650.0" text="Nom du Club" />
        </columns>
    </TableView>

    <!-- FORMULAIRE DE MODIFICATION -->
    <VBox fx:id="formModifier" alignment="CENTER" spacing="15.0" style="-fx-background-color: #f9f9f9; -fx-padding: 15; -fx-border-color: #dddddd;">
        <GridPane hgap="10" vgap="15" alignment="CENTER">
            <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="tfName" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250" />

            <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cbStatus" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250"/>

            <Label text="Description:" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="2" />
            <TextArea fx:id="taDescription" GridPane.columnIndex="3" GridPane.rowIndex="0" GridPane.rowSpan="2" prefHeight="80.0" prefWidth="250"/>
        </GridPane>

        <Button mnemonicParsing="false" onAction="#updateClub" prefHeight="35.0" prefWidth="180.0" style="-fx-base: #FF9800;" text="Modifier dans la BD" textFill="WHITE">
            <font><Font name="System Bold" size="14.0" /></font>
        </Button>
    </VBox>

    <Button mnemonicParsing="false" onAction="#goBack" prefHeight="35.0" prefWidth="150.0" text="Retour au Menu" />
</VBox>
