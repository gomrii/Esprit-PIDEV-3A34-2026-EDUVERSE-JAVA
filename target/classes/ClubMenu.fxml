<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ClubMenuController">
    <padding> <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /> </padding>

    <Label text="Menu des Clubs">
        <font> <Font name="System Bold" size="24.0" /> </font>
    </Label>
    
    <Button mnemonicParsing="false" onAction="#goToAjouterClub" prefHeight="40.0" prefWidth="250.0" text="1. Ajouter un Club" />
    <Button mnemonicParsing="false" onAction="#goToAfficherClub" prefHeight="40.0" prefWidth="250.0" text="2. Afficher les Clubs" />
    <Button mnemonicParsing="false" onAction="#goToModifierClub" prefHeight="40.0" prefWidth="250.0" text="3. Modifier un Club" />
    <Button mnemonicParsing="false" onAction="#goToSupprimerClub" prefHeight="40.0" prefWidth="250.0" text="4. Supprimer un Club" />
    
    <Label text="" /> <!-- Espace -->

    <Button mnemonicParsing="false" onAction="#goBackHome" prefHeight="35.0" prefWidth="200.0" style="-fx-border-color: black; -fx-background-color: transparent;" text="Retour au Menu Principal" />
</VBox>
