<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.SupprimerClubController">
    <padding> <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /> </padding>

    <Label text="Supprimer un Club" textFill="#e74c3c">
        <font> <Font name="System Bold" size="24.0" /> </font>
    </Label>

    <TableView fx:id="tvClubs" prefHeight="350.0" prefWidth="760.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="650.0" text="Nom du Club" />
        </columns>
    </TableView>

    <Button mnemonicParsing="false" onAction="#deleteClub" prefHeight="40.0" prefWidth="200.0" style="-fx-base: #e74c3c;" text="SUPPRIMER" textFill="WHITE">
        <font><Font name="System Bold" size="16.0" /></font>
    </Button>

    <Label text="" /> <!-- Espace -->

    <Button mnemonicParsing="false" onAction="#goBack" prefHeight="35.0" prefWidth="150.0" text="Retour au Menu" />
</VBox>
