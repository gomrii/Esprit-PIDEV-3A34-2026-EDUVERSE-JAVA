<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.elearning.controller.FormationDetailController"
            prefWidth="1000" prefHeight="800" styleClass="main-container">

    <top>
        <VBox spacing="16" styleClass="detail-header">
            <padding><Insets top="16" right="16" left="16"/></padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnBack" text="← Retour" styleClass="btn-secondary"/>
                <Pane HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="titleLabel" text="Titre de la Formation" styleClass="page-title"/>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label fx:id="levelLabel" text="Niveau: " styleClass="info-label"/>
                <Label fx:id="durationLabel" text="Durée: " styleClass="info-label"/>
                <Label fx:id="priceLabel" text="Prix: " styleClass="info-label"/>
                <Label fx:id="creatorLabel" text="Créé par: " styleClass="info-label"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16" styleClass="detail-content">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                <!-- Description Section -->
                <VBox spacing="8">
                    <Label text="Description" styleClass="section-title"/>
                    <TextArea fx:id="descriptionArea" prefRowCount="4" styleClass="text-area-read-only"/>
                </VBox>

                <!-- Content Section -->
                <VBox spacing="8">
                    <Label text="Contenu" styleClass="section-title"/>
                    <TextArea fx:id="contentArea" prefRowCount="8" styleClass="text-area-read-only"/>
                </VBox>

                <!-- Resources Section (hidden by default for non-enrolled students) -->
                <VBox fx:id="ressourcesSection" spacing="8">
                    <Label text="Ressources" styleClass="section-title"/>
                    <TableView fx:id="ressourcesTable" prefHeight="200" styleClass="users-table">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colRessTitle" text="Titre" prefWidth="300"/>
                            <TableColumn fx:id="colRessType" text="Type" prefWidth="150"/>
                            <TableColumn fx:id="colRessUrl" text="URL" prefWidth="400"/>
                        </columns>
                        <placeholder><Label text="Aucune ressource disponible."/></placeholder>
                    </TableView>
                </VBox>

                <!-- Enrolled Students Section (visible only to teacher/admin) -->
                <VBox fx:id="enrolledStudentsSection" spacing="8">
                    <Label text="Étudiants Inscrits" styleClass="section-title"/>
                    <TableView fx:id="enrolledStudentsTable" prefHeight="150" styleClass="users-table">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colStudentName" text="Nom de l'étudiant" prefWidth="300"/>
                            <TableColumn fx:id="colStudentEmail" text="Email" prefWidth="400"/>
                        </columns>
                        <placeholder><Label text="Aucun étudiant inscrit."/></placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="10" styleClass="detail-footer">
            <padding><Insets top="10" right="16" bottom="16" left="16"/></padding>
            
            <Label fx:id="enrollStatusLabel" text="Vérification du statut..." styleClass="status-label"/>
            
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnEnroll" text="S'inscrire à cette formation" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
