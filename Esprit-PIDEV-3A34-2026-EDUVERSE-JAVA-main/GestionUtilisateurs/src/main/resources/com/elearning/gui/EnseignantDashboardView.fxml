<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.elearning.controller.EnseignantDashboardController"
            prefWidth="1150" prefHeight="720">

    <left>
        <VBox styleClass="sidebar" spacing="8" prefWidth="220">
            <VBox styleClass="sidebar-header" alignment="CENTER">
                <padding><Insets top="20" bottom="20"/></padding>
                <Label text="Espace Enseignant" styleClass="sidebar-username"/>
                <Label fx:id="welcomeLabel" text="Bienvenue"/>
            </VBox>

            <VBox styleClass="sidebar-menu" spacing="6">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Button fx:id="btnToutesFormations" text="Toutes les formations"
                        styleClass="sidebar-item sidebar-item-active"
                        maxWidth="Infinity"
                        onAction="#handleShowToutesFormations"/>
                <Button fx:id="btnMesFormations" text="Mes formations"
                        styleClass="sidebar-item"
                        maxWidth="Infinity"
                        onAction="#handleShowMesFormations"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
                <padding><Insets bottom="20"/></padding>
                <Button text="Se deconnecter"
                        styleClass="btn-logout"
                        maxWidth="Infinity"
                        onAction="#handleDeconnexion"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" styleClass="main-content">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Gestion des formations (enseignant)" styleClass="page-title"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher par titre ou description..." prefWidth="260" styleClass="search-field"/>
                <ComboBox fx:id="levelFilter" prefWidth="130"/>
                <ComboBox fx:id="sortColumn" prefWidth="130"/>
                <ComboBox fx:id="sortDirection" prefWidth="90"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Creer une nouvelle formation"
                        styleClass="btn-primary"
                        onAction="#handleCreateFormation"/>
                <Button text="Actualiser les donnees"
                        styleClass="btn-secondary"
                        onAction="#handleRefresh"/>
            </HBox>

            <SplitPane dividerPositions="0.58" VBox.vgrow="ALWAYS">
                <items>
                    <VBox spacing="8">
                        <Label text="Catalogue des formations (admin + enseignants)" styleClass="stat-label"/>
                        <TableView fx:id="tableFormations" VBox.vgrow="ALWAYS" styleClass="users-table">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="65"/>
                                <TableColumn fx:id="colTitle" text="Titre" prefWidth="230"/>
                                <TableColumn fx:id="colCreator" text="Cree par" prefWidth="170"/>
                                <TableColumn fx:id="colLevel" text="Niveau" prefWidth="120"/>
                                <TableColumn fx:id="colDuration" text="Duree" prefWidth="120"/>
                                <TableColumn fx:id="colApproval" text="Statut" prefWidth="130"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Etudiants inscrits a mes formations" styleClass="stat-label"/>
                        <TableView fx:id="tableEnrolled" VBox.vgrow="ALWAYS" styleClass="users-table">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colEnrFormation" text="Formation" prefWidth="180"/>
                                <TableColumn fx:id="colEnrStudent" text="Etudiant" prefWidth="160"/>
                                <TableColumn fx:id="colEnrEmail" text="Email" prefWidth="190"/>
                                <TableColumn fx:id="colEnrDate" text="Date inscription" prefWidth="170"/>
                            </columns>
                        </TableView>
                    </VBox>
                </items>
            </SplitPane>
        </VBox>
    </center>

</BorderPane>
