<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="1000.0" spacing="20.0" 
      styleClass="main-content" stylesheets="@css/style.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="Controllers.PendingRequestsController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30" />
    </padding>

    <Label text="Centre de Validation Admin" styleClass="page-title"/>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <!-- ONGLET ÉVÉNEMENTS -->
            <Tab text="📅 Événements">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <TableView fx:id="tvPendingEvents" prefHeight="400.0" styleClass="users-table">
                        <columns>
                            <TableColumn fx:id="colEventTitle" prefWidth="300.0" text="Événement" />
                            <TableColumn fx:id="colEventDate" prefWidth="150.0" text="Date" />
                            <TableColumn fx:id="colEventActions" prefWidth="250.0" text="Actions" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ONGLET CLUBS (Rétabli) -->
            <Tab text="👥 Nouveaux Clubs">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <TableView fx:id="tvPendingClubs" prefHeight="400.0" styleClass="users-table">
                        <columns>
                            <TableColumn fx:id="colClubName" prefWidth="400.0" text="Nom du Club" />
                            <TableColumn fx:id="colClubActions" prefWidth="250.0" text="Actions" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ONGLET ADHÉSIONS -->
            <Tab text="🤝 Demandes Adhésion">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                    <TableView fx:id="tvJoinRequests" prefHeight="400.0" styleClass="users-table">
                        <columns>
                            <TableColumn fx:id="colUserReq" prefWidth="200.0" text="Utilisateur" />
                            <TableColumn fx:id="colClubReq" prefWidth="200.0" text="Club" />
                            <TableColumn fx:id="colJoinActions" prefWidth="250.0" text="Actions" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>

</VBox>
