<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Tableau de Bord - EduVerse" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Label>

    <Button mnemonicParsing="false" onAction="#goToEventMenu" prefHeight="50.0" prefWidth="250.0" style="-fx-base: #3498db;" text="Gérer les Événements" textFill="WHITE">
        <font><Font name="System Bold" size="16.0" /></font>
    </Button>

    <Button mnemonicParsing="false" onAction="#goToClubMenu" prefHeight="50.0" prefWidth="250.0" style="-fx-base: #2ecc71;" text="Gérer les Clubs" textFill="WHITE">
        <font><Font name="System Bold" size="16.0" /></font>
    </Button>

    <Button mnemonicParsing="false" onAction="#quitApp" prefHeight="40.0" prefWidth="150.0" style="-fx-base: #e74c3c;" text="Quitter" textFill="WHITE">
        <font><Font name="System Bold" size="14.0" /></font>
    </Button>
</VBox>
