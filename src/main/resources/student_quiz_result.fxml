<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.Controller.StudentQuizResultController">
    <left>
        <VBox prefWidth="220" spacing="0" styleClass="sidebar">
            <VBox alignment="CENTER" styleClass="sidebar-header">
                <padding>
                    <Insets top="20" bottom="20"/>
                </padding>
                <ImageView fitHeight="100" preserveRatio="true">
                    <image>
                        <Image url="@eduverse-logo.png"/>
                    </image>
                </ImageView>
                <Label styleClass="sidebar-username" text="Étudiant"/>
            </VBox>
            <VBox spacing="4">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <Label styleClass="sidebar-item" text="Quiz validés"/>
                <Label styleClass="sidebar-item" text="Passage du quiz"/>
                <Label styleClass="sidebar-item sidebar-item-active" text="Résultat"/>
            </VBox>
            <VBox alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="20" left="10" right="10"/>
                </padding>
                <Button maxWidth="Infinity" onAction="#handleBack" styleClass="btn-logout" text="Retour liste"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label styleClass="page-title" text="Résultat du Quiz"/>
            <VBox alignment="CENTER" spacing="16" styleClass="stat-card stat-green" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="36" right="36" bottom="36" left="36"/>
                </padding>
                <Label fx:id="quizTitleLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Résultat du quiz"/>
                <Label fx:id="scoreLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Score final : 0 / 0"/>
                <Label fx:id="percentageLabel" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" text="Pourcentage : 0%"/>
                <Label fx:id="answeredLabel" style="-fx-font-size: 16px; -fx-text-fill: #2c3e50;" text="Questions répondues : 0 / 0"/>
                <Label fx:id="summaryLabel" styleClass="page-subtitle" text="Quiz soumis." wrapText="true"/>
                <HBox alignment="CENTER" spacing="12">
                    <Button onAction="#handleDownloadPdf" styleClass="btn-primary" text="Télécharger PDF"/>
                    <Button onAction="#handleBack" styleClass="btn-secondary" text="Retour à la liste"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
