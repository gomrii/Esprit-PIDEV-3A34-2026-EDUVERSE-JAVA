<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AfficherEventController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Liste des Événements">
        <font> <Font name="System Bold" size="24.0" /> </font>
    </Label>

    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <Label text="Recherche transversale :" />
        <TextField fx:id="tfSearch" prefWidth="300.0" promptText="Tapez pour filtrer..." />
        <Label text="" HBox.hgrow="ALWAYS" maxWidth="Infinity" /> 
        <Button mnemonicParsing="false" onAction="#trierAZ" prefHeight="30.0" prefWidth="90.0" style="-fx-base: #3498db;" text="Trier A-Z" textFill="WHITE">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>
        <Button mnemonicParsing="false" onAction="#exportPDF" prefHeight="30.0" prefWidth="120.0" style="-fx-base: #e74c3c;" text="Exporter PDF" textFill="WHITE">
            <font><Font name="System Bold" size="12.0" /></font>
        </Button>
    </HBox>

    <TableView fx:id="tvEvents" prefHeight="400.0" prefWidth="760.0">
        <columns>
            <TableColumn fx:id="colTitle" prefWidth="150.0" text="Nom (Titre)" />
            <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
            <TableColumn fx:id="colLocation" prefWidth="150.0" text="Lieu" />
            <TableColumn fx:id="colStatus" prefWidth="150.0" text="Statut" />
        </columns>
      <columnResizePolicy>
         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
      </columnResizePolicy>
    </TableView>

    <Button mnemonicParsing="false" onAction="#goBack" prefHeight="35.0" prefWidth="150.0" text="Retour au Menu" />
</VBox>
