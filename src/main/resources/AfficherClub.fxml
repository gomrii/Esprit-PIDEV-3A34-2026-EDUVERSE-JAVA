<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20.0" styleClass="main-content" 
      stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AfficherClubController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox>
                <Label text="Gestion des Clubs" styleClass="page-title" />
                <Label text="Explorez les communautés ou gérez les vôtres" style="-fx-text-fill: #64748b; -fx-font-size: 14px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAjouterClub" onAction="#goAjouterClub" styleClass="btn-primary" text="+ Nouveau Club" />
        </HBox>
        
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 0 0;">
            <TextField fx:id="tfSearch" promptText="Rechercher un club..." styleClass="search-field" prefWidth="350" />
            <Button text="🔍" styleClass="btn-secondary" />
        </HBox>
    </VBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <!-- ONGLET TOUS LES CLUBS -->
            <Tab text="🌍 Découvrir les Clubs">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <FlowPane fx:id="clubsContainer" hgap="20" vgap="20" style="-fx-padding: 20;" />
                </ScrollPane>
            </Tab>

            <!-- ONGLET MES CLUBS (Visible uniquement pour non-admin) -->
            <Tab fx:id="tabMyClubs" text="🏠 Mes Clubs">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <FlowPane fx:id="myClubsContainer" hgap="20" vgap="20" style="-fx-padding: 20;" />
                </ScrollPane>
            </Tab>
        </tabs>
    </TabPane>

</VBox>
