<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="850.0" spacing="20.0" style="-fx-background-color: #F8F9FD;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ModifierChapitre">
    <children>
        <VBox alignment="CENTER" spacing="5.0">
            <children>
                <Label text="Modification du Chapitre" textFill="#2D2D50">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>
                <Label text="Mettez à jour les informations du chapitre sélectionné" textFill="#636E72" />
            </children>
        </VBox>

        <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
            <Button mnemonicParsing="false" onAction="#gotochapitres" text="chapitres" />
                <Label text="Sélectionner le Cours *" />
                <ComboBox fx:id="coursComboBox" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-radius: 10;" />

                <Label text="Titre du Chapitre *" />
                <TextField fx:id="titleField" prefHeight="40.0" style="-fx-background-radius: 10;" />

                <Label text="Contenu (Texte) *" />
                <TextArea fx:id="contentArea" prefHeight="150.0" style="-fx-background-radius: 10;" wrapText="true" />

                <HBox spacing="20.0">
                    <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Support Vidéo (.mp4)" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button onAction="#handleChooseVideo" prefHeight="35.0" style="-fx-background-color: white; -fx-border-color: #3C3362; -fx-border-radius: 20;" text="🎬 Modifier Vidéo" />
                                        <Label fx:id="videoPathLabel" text="Aucun fichier" textFill="#95a5a6" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Document PDF (.pdf)" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button onAction="#handleChoosePdf" prefHeight="35.0" style="-fx-background-color: white; -fx-border-color: #e74c3c; -fx-border-radius: 20;" text="📄 Modifier PDF" />
                                        <Label fx:id="pdfPathLabel" text="Aucun fichier" textFill="#95a5a6" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15.0">
                    <children>
                        <Button maxWidth="Infinity" onAction="#handleUpdate" prefHeight="50.0" style="-fx-background-color: #3C3362; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="Enregistrer les modifications" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCancel" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: #BDC3C7; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;" text="Annuler" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
</VBox>

