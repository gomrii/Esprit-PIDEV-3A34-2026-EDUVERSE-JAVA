<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.Controller.TeacherQuizListController">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Mes Quiz (Enseignant)" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
            <Label text="Les quiz créés par l'admin sont en lecture seule" style="-fx-text-fill: #ecf0f1; -fx-font-size: 12; -fx-padding: 10 0 0 0;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 15;">
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <TextField fx:id="searchTF" promptText="Rechercher par titre, statut ou créateur..." style="-fx-min-width: 300;"/>
                <Button text="Rechercher" onAction="#handleSearch"/>
                <ChoiceBox fx:id="sortChoice" style="-fx-min-width: 180;"/>
                <Button text="Actualiser" onAction="#handleRefresh"/>
            </HBox>

            <TableView fx:id="quizzesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colTitle" text="Titre" prefWidth="250"/>
                    <TableColumn fx:id="colStatus" text="Statut" prefWidth="120"/>
                    <TableColumn fx:id="colCreatedBy" text="Créé par" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 15;">
            <Button text="Ajouter" onAction="#handleAdd" styleClass="primary-button"/>
            <Button fx:id="btnModify" text="Modifier" onAction="#handleEdit" styleClass="primary-button" disable="true"/>
            <Button fx:id="btnDelete" text="Supprimer" onAction="#handleDelete" styleClass="danger-button" disable="true"/>
            <Button fx:id="btnManageQuestions" text="Gérer Questions" onAction="#handleManageQuestions" styleClass="success-button" disable="true"/>
            <Button text="Retour" onAction="#handleBack" style="-fx-margin-left: 50;"/>
        </HBox>
    </bottom>
</BorderPane>
