<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.elearning.controller.SimpleViewController"
      spacing="22"
      styleClass="main-content,role-dashboard-page"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="student-dashboard-stats-row">
        <VBox styleClass="admin-dashboard-stat-card" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📝" styleClass="admin-dashboard-stat-icon,admin-dashboard-stat-icon-violet"/>
                <Label text="Quiz disponibles" styleClass="admin-dashboard-stat-title"/>
            </HBox>
            <Label text="0" styleClass="admin-dashboard-stat-number"/>
            <Label text="Quiz a lancer depuis votre espace" styleClass="admin-dashboard-stat-description"/>
        </VBox>
        <VBox styleClass="admin-dashboard-stat-card" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📘" styleClass="admin-dashboard-stat-icon,admin-dashboard-stat-icon-blue"/>
                <Label text="Cours" styleClass="admin-dashboard-stat-title"/>
            </HBox>
            <Label text="0" styleClass="admin-dashboard-stat-number"/>
            <Label text="Cours disponibles a consulter" styleClass="admin-dashboard-stat-description"/>
        </VBox>
        <VBox styleClass="admin-dashboard-stat-card" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🎓" styleClass="admin-dashboard-stat-icon,admin-dashboard-stat-icon-green"/>
                <Label text="Formations" styleClass="admin-dashboard-stat-title"/>
            </HBox>
            <Label text="0" styleClass="admin-dashboard-stat-number"/>
            <Label text="Formations accessibles dans EduVerse" styleClass="admin-dashboard-stat-description"/>
        </VBox>
        <VBox styleClass="admin-dashboard-stat-card" alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🏅" styleClass="admin-dashboard-stat-icon,admin-dashboard-stat-icon-orange"/>
                <Label text="Clubs" styleClass="admin-dashboard-stat-title"/>
            </HBox>
            <Label text="0" styleClass="admin-dashboard-stat-number"/>
            <Label text="Clubs a rejoindre ou suivre" styleClass="admin-dashboard-stat-description"/>
        </VBox>
    </HBox>

    <VBox spacing="8" styleClass="role-dashboard-hero">
        <Label text="Dashboard Etudiant" styleClass="page-title"/>
        <Label fx:id="welcomeLabel" text="Bienvenue !" styleClass="role-dashboard-subtitle"/>
        <Label text="Consultez vos quiz, vos resultats et vos contenus de formation dans un espace plus lisible."
               wrapText="true"
               styleClass="role-dashboard-description"/>
    </VBox>

    <FlowPane hgap="16" vgap="16" prefWrapLength="980" styleClass="role-dashboard-grid">
        <VBox styleClass="stat-card,role-dashboard-card" spacing="8">
            <Label text="Formations" styleClass="role-dashboard-card-title"/>
            <Label text="Accedez rapidement a votre catalogue de cours et suivez votre progression."
                   wrapText="true"
                   styleClass="role-dashboard-card-text"/>
        </VBox>
        <VBox styleClass="stat-card,role-dashboard-card" spacing="8">
            <Label text="Quiz" styleClass="role-dashboard-card-title"/>
            <Label text="Lancez vos quiz, continuez vos sessions et consultez les resultats en un clic."
                   wrapText="true"
                   styleClass="role-dashboard-card-text"/>
        </VBox>
        <VBox styleClass="stat-card,role-dashboard-card" spacing="8">
            <Label text="Resultats" styleClass="role-dashboard-card-title"/>
            <Label text="Suivez vos scores, vos tentatives et vos progres sur l'ensemble des evaluations."
                   wrapText="true"
                   styleClass="role-dashboard-card-text"/>
        </VBox>
    </FlowPane>
</VBox>
