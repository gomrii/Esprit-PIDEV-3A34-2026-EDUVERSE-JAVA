<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<!--
  LoginView.fxml — Vue de connexion

  Équivalent Symfony : templates/security/login.html.twig
  Le fx:controller lie cette vue à LoginController.java
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.elearning.controller.LoginController"
      styleClass="login-container"
      spacing="0"
      alignment="CENTER"
      prefWidth="500" prefHeight="400">

    <!-- En-tête -->
    <VBox styleClass="login-header" alignment="CENTER" spacing="8">
        <padding><Insets top="30" bottom="20"/></padding>
        <Label text="🎓 e-Learning" styleClass="login-logo"/>
        <Label text="Gestion des Utilisateurs" styleClass="login-subtitle"/>
    </VBox>

    <!-- Formulaire -->
    <VBox styleClass="login-form" spacing="16" alignment="CENTER">
        <padding><Insets top="20" right="60" bottom="10" left="60"/></padding>

        <!-- Message d'erreur global -->
        <Label fx:id="errorLabel" styleClass="error-global" wrapText="true"
               visible="false" managed="false"/>

        <!-- Champ Email -->
        <VBox spacing="4">
            <Label text="Adresse e-mail" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="votre@email.tn"
                       styleClass="text-field"/>
        </VBox>

        <!-- Champ Mot de passe -->
        <VBox spacing="4">
            <Label text="Mot de passe" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"
                           styleClass="text-field"/>
        </VBox>

        <!-- Bouton connexion -->
        <Button fx:id="loginButton" text="Se connecter →"
                styleClass="btn-primary" maxWidth="Infinity"
                onAction="#handleLogin"/>

    </VBox>

    <!-- Note de démonstration -->
    <VBox alignment="CENTER" spacing="4">
        <padding><Insets top="10" bottom="15"/></padding>
        <Label text="Compte démo : admin@elearning.tn / Admin123!"
               styleClass="demo-note"/>
    </VBox>

    <!-- Lien vers inscription -->
    <VBox alignment="CENTER" spacing="4">
        <padding><Insets bottom="20"/></padding>
        <HBox alignment="CENTER" spacing="4">
            <Text text="Pas de compte ?" style="-fx-fill: #666; -fx-font-size: 13;"/>
            <Hyperlink text="S'inscrire" style="-fx-font-size: 13;" onAction="#allerVersInscription"/>
        </HBox>
    </VBox>

</VBox>
