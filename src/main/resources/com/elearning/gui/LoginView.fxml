<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.elearning.controller.LoginController"
           styleClass="login-root">

    <!-- Carte blanche centrée -->
    <HBox alignment="CENTER" spacing="0">

        <!-- Panneau gauche : visuel décoratif -->
        <VBox styleClass="login-left-panel" alignment="CENTER" spacing="20"
              prefWidth="420" prefHeight="600"
              style="-fx-background-color: linear-gradient(to bottom, #1e3a5f, #2980b9); -fx-padding: 50;">

            <!-- Logo grand format -->
            <ImageView fitWidth="180" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>
            <Label text="Eduverse" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Plateforme e-Learning"
                   style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.75);"/>

            <!-- Séparateur décoratif -->
            <Region prefHeight="1" prefWidth="80"
                    style="-fx-background-color: rgba(255,255,255,0.3);"/>

            <Label text="&quot;Apprendre sans jamais cesser&quot;"
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.6); -fx-font-style: italic;"/>

            <!-- Badges statistiques -->
            <HBox spacing="20" alignment="CENTER">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="500+" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    <Label text="Étudiants" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="50+" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                    <Label text="Cours" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="20+" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <Label text="Instructeurs" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Panneau droit : formulaire -->
        <VBox styleClass="login-card" spacing="20" alignment="CENTER"
              prefWidth="480">

            <!-- En-tête du formulaire -->
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Connexion" styleClass="login-app-name"/>
                <Label text="Accédez à votre espace personnel" styleClass="login-subtitle"/>
            </VBox>

            <!-- Séparateur -->
            <Region prefHeight="1" maxWidth="Infinity" styleClass="login-divider"/>

            <!-- Message d'erreur -->
            <Label fx:id="errorLabel" styleClass="login-error"
                   wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false"/>

            <!-- Champ email -->
            <VBox spacing="6">
                <Label text="ADRESSE E-MAIL" styleClass="login-field-label"/>
                <TextField fx:id="emailField" promptText="votre@email.tn"
                           styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <!-- Champ mot de passe -->
            <VBox spacing="6">
                <Label text="MOT DE PASSE" styleClass="login-field-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <!-- Bouton connexion classique -->
            <Button fx:id="loginButton" text="⌨️ Se connecter"
                    styleClass="login-btn" maxWidth="Infinity"
                    onAction="#handleLogin"/>

            <Separator/>
            <Label text="— ou —" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"
                   maxWidth="Infinity" alignment="CENTER"/>
                   
            <Button text="👤 Se connecter par Face ID"
                    onAction="#handleFaceIdLogin"
                    maxWidth="Infinity"
                    style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-padding: 9 18 9 18;
                           -fx-font-size: 13px; -fx-cursor: hand;"/>
            <Label text="💡 Saisissez votre email ci-dessus puis cliquez sur Face ID"
                   style="-fx-font-size: 10px; -fx-text-fill: #95a5a6;"
                   maxWidth="Infinity" alignment="CENTER"/>

        <VBox spacing="6">
                <Label text="VÉRIFICATION ANTI-BOT" styleClass="login-field-label"/>
                <Label fx:id="captchaInstruction" text="Pointez la flèche vers le haut" style="-fx-text-fill: #2c3e50; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Canvas fx:id="captchaCanvas" width="220" height="60"
                            style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 4, 0, 0, 2); -fx-background-radius: 8;"/>
                    <Button text="🔁" onAction="#handleRefreshCaptcha"
                            style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-cursor: hand;"
                            prefWidth="36" prefHeight="36"/>
                </HBox>
                <Slider fx:id="captchaSlider" min="-180" max="180" value="0" blockIncrement="10"
                        style="-fx-padding: 10 0 10 0; -fx-cursor: hand;"/>
                <Label fx:id="errCaptcha" text=""
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"
                       visible="false" managed="false" wrapText="true"/>
            </VBox>

            <!-- Badge démo -->
            <Label text="💡  Démo : admin@elearning.tn  /  Admin123!"
                   styleClass="demo-badge" maxWidth="Infinity"
                   alignment="CENTER" textAlignment="CENTER"/>

            <!-- Inscription + Mot de passe oublié -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Pas encore de compte ?" style="-fx-text-fill: #7f8c8d;"/>
                <Hyperlink text="S'inscrire" onAction="#allerVersInscription"
                           style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-underline: true;"/>
            </HBox>
            <HBox alignment="CENTER">
                <Hyperlink text="🔑 Mot de passe oublié ?" onAction="#handleMotDePasseOublie"
                           style="-fx-text-fill: #e67e22; -fx-font-size: 12px;"/>
            </HBox>

        </VBox>
    </HBox>
</StackPane>
