<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.elearning.controller.FormationDetailController"
      prefWidth="1200" prefHeight="800" spacing="20" style="-fx-background-color: #f4f7f6;"
      stylesheets="@css/style.css">

    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

    <!-- Header Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button fx:id="btnBack" text="⬅ Retour" styleClass="btn-secondary" style="-fx-padding: 8 12;"/>
            <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" text="Titre de la Formation" styleClass="page-title"/>
                <Label fx:id="creatorLabel" text="Créé par: " style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" fx:id="enrollStatusLabel" text="Status: Vérification..."/>
            </HBox>
        </HBox>

        <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
            <VBox spacing="2">
                <Label text="Niveau" style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
                <Label fx:id="levelLabel" text="Intermédiaire" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="2">
                <Label text="Durée" style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
                <Label fx:id="durationLabel" text="40 heures" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            </VBox>
            <VBox spacing="2">
                <Label text="Prix" style="-fx-text-fill: #999; -fx-font-size: 12px;"/>
                <Label fx:id="priceLabel" text="99,99€" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Main Content -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0;">
        <VBox spacing="20" style="-fx-padding: 0;">

            <!-- Description Section -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Label text="📝 Description" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true" editable="false" 
                          style="-fx-control-inner-background: #f9f9f9; -fx-padding: 12; -fx-border-radius: 8;"/>
            </VBox>

            <!-- Content Section -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Label text="📖 Contenu du Cours" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TextArea fx:id="contentArea" prefRowCount="8" wrapText="true" editable="false"
                          style="-fx-control-inner-background: #f9f9f9; -fx-padding: 12; -fx-border-radius: 8;"/>
            </VBox>

            <!-- Resources Section -->
            <VBox fx:id="ressourcesSection" spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Label text="📚 Ressources" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TableView fx:id="ressourcesTable" prefHeight="200" style="-fx-background-radius: 8;">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colRessTitle" text="Titre" prefWidth="300"/>
                        <TableColumn fx:id="colRessType" text="Type" prefWidth="150"/>
                        <TableColumn fx:id="colRessUrl" text="URL" prefWidth="400"/>
                    </columns>
                    <placeholder><Label text="Aucune ressource disponible."/></placeholder>
                </TableView>
            </VBox>

            <!-- Enrolled Students Section -->
            <VBox fx:id="enrolledStudentsSection" spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <Label text="👥 Étudiants Inscrits" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <TableView fx:id="enrolledStudentsTable" prefHeight="150" style="-fx-background-radius: 8;">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colStudentName" text="Nom de l'étudiant" prefWidth="300"/>
                        <TableColumn fx:id="colStudentEmail" text="Email" prefWidth="400"/>
                    </columns>
                    <placeholder><Label text="Aucun étudiant inscrit."/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Action Buttons -->
    <HBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <Button fx:id="btnFreeEnroll" text="✓ S'inscrire Gratuitement" styleClass="btn-secondary" style="-fx-padding: 12 20;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEnroll" text="💳 Acheter la Formation" styleClass="btn-primary" style="-fx-padding: 12 20;" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>
