<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.elearning.controller.FormationFormController"
            fitToWidth="true">
    <VBox spacing="12" styleClass="main-content" style="-fx-padding: 16;">
        <Label fx:id="titleLabel" text="Add Formation" styleClass="page-title"/>

        <!-- Formation Details Section -->
        <TitledPane text="Formation Details" expanded="true" collapsible="false">
            <VBox spacing="12" style="-fx-padding: 12;">
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="28"/>
                        <ColumnConstraints percentWidth="72"/>
                    </columnConstraints>

                    <Label text="Title" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="titleField" promptText="Formation title" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Description" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <VBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextArea fx:id="descriptionField" prefRowCount="3" wrapText="true" VBox.vgrow="ALWAYS"/>
                        <Button fx:id="generateDescriptionButton" text="🤖 Generate with AI" onAction="#handleGenerateDescription" styleClass="btn-secondary"/>
                    </VBox>

                    <Label text="Content" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextArea fx:id="contentField" prefRowCount="5" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Price" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="priceField" promptText="e.g. 99.90" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Duration" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="durationField" promptText="Hours" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Level" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="levelCombo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="Support PDF" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                        <TextField fx:id="supportFileField" promptText="Select a PDF file" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse PDF" onAction="#handleBrowseSupportPdf"/>
                    </HBox>

                    <HBox spacing="16" GridPane.rowIndex="7" GridPane.columnIndex="1">
                        <CheckBox fx:id="approvedCheck" text="Approved"/>
                        <CheckBox fx:id="archivedCheck" text="Archived"/>
                    </HBox>
                </GridPane>
            </VBox>
        </TitledPane>

        <!-- Ressources Section -->
        <TitledPane text="Ressources (Add learning materials like videos, documentation, etc.)" expanded="true" collapsible="false">
            <VBox spacing="12" style="-fx-padding: 12;">
                <!-- Ressource Input Form -->
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="75"/>
                    </columnConstraints>

                    <Label text="Title" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="ressourceTitleField" promptText="Ressource title" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Description" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextArea fx:id="ressourceDescriptionField" prefRowCount="2" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="URL/Link" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="ressourceUrlField" promptText="https://example.com/resource" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Type" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="ressourceTypeCombo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="File Path" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="ressourceFilePathField" promptText="/path/to/file.pdf" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Cost" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="ressourceCostField" promptText="e.g. 29.99 (optional)" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="addRessourceButton" text="+ Add Ressource" onAction="#handleAddRessource" styleClass="btn-primary"/>
                </HBox>

                <!-- Ressources Table -->
                <Label text="Added Ressources:" styleClass="subtitle"/>
                <TableView fx:id="ressourcesTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="ressourceTitleColumn" text="Title" prefWidth="200"/>
                        <TableColumn fx:id="ressourceTypeColumn" text="Type" prefWidth="150"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="removeRessourceButton" text="- Remove Selected" onAction="#handleRemoveRessource" styleClass="btn-danger"/>
                </HBox>
            </VBox>
        </TitledPane>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="saveButton" text="Save" onAction="#handleSave" styleClass="btn-primary"/>
            <Button text="Cancel" onAction="#handleCancel"/>
        </HBox>
    </VBox>
</ScrollPane>
