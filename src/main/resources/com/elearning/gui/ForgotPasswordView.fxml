<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    ForgotPasswordView.fxml — Demande de réinitialisation de mot de passe
    Controller : com.elearning.controller.ForgotPasswordController
    Dimensions : 460 × 360
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elearning.controller.ForgotPasswordController"
      styleClass="login-root"
      alignment="CENTER"
      spacing="0">

    <!-- En-tête -->
    <VBox styleClass="login-header" alignment="CENTER" spacing="8">
        <Label text="🔑" style="-fx-font-size: 40px;"/>
        <Label text="Mot de passe oublié" styleClass="login-title"/>
        <Label text="Entrez votre email pour recevoir un code de réinitialisation."
               styleClass="login-subtitle" wrapText="true" maxWidth="340" textAlignment="CENTER"/>
    </VBox>

    <!-- Formulaire -->
    <VBox styleClass="login-form" spacing="18" alignment="CENTER">

        <!-- Champ email -->
        <VBox spacing="6">
            <Label text="ADRESSE EMAIL" styleClass="login-field-label"/>
            <TextField fx:id="emailField"
                       promptText="votre@email.com"
                       styleClass="login-field"
                       maxWidth="Infinity"/>
            <Label fx:id="errEmail" text=""
                   styleClass="error-inline"
                   visible="false" managed="false"
                   wrapText="true" maxWidth="320"/>
        </VBox>

        <!-- Loader -->
        <ProgressIndicator fx:id="loading" visible="false"
                           prefWidth="28" prefHeight="28"/>

        <!-- Boutons -->
        <VBox spacing="10">
            <Button fx:id="btnEnvoyer"
                    text="📧 Envoyer le code"
                    onAction="#handleEnvoyer"
                    styleClass="login-btn"
                    maxWidth="Infinity"/>
            <Button text="← Retour à la connexion"
                    onAction="#handleRetour"
                    styleClass="btn-outline"
                    maxWidth="Infinity"/>
        </VBox>

    </VBox>
</VBox>
