<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.elearning.controller.FormationDashboardController"
            prefWidth="1000" prefHeight="620">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="main-content">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="Gestion des Formations" styleClass="page-title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Add" onAction="#handleAdd" styleClass="btn-primary"/>
            <Button text="Edit" onAction="#handleEdit" styleClass="btn-success"/>
            <Button text="Delete" onAction="#handleDelete" styleClass="btn-supprimer"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="main-content">
            <padding><Insets right="16" bottom="16" left="16"/></padding>
            <TableView fx:id="tableFormations" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="260"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="130"/>
                    <TableColumn fx:id="colLevel" text="Level" prefWidth="150"/>
                    <TableColumn fx:id="colDuration" text="Duration" prefWidth="120"/>
                    <TableColumn fx:id="colApproved" text="Approved" prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="No formations found."/>
                </placeholder>
            </TableView>
        </VBox>
    </center>
</BorderPane>
