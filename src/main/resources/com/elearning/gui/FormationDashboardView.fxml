<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="800.0" prefWidth="1200.0" spacing="20.0" style="-fx-background-color: #f4f7f6;"
      stylesheets="@css/style.css" xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17" fx:controller="com.elearning.controller.FormationDashboardController">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25" />
    </padding>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Button onAction="#handleCancel" text="⬅ Retour" styleClass="btn-secondary" style="-fx-padding: 8 12;"/>
            <VBox>
                <Label text="Gestion des Formations" styleClass="page-title" />
                <Label text="Parcourez et gérez toutes les formations disponibles" style="-fx-text-fill: #64748b; -fx-font-size: 14px;" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox spacing="10">
                <Button onAction="#handleExportPdf" styleClass="btn-danger" text="📄 Exporter PDF" />
                <Button fx:id="btnAjouter" onAction="#handleAdd" styleClass="btn-primary" text="➕ Nouvelle Formation" />
            </HBox>
        </HBox>
        
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 0 0;">
            <TextField fx:id="searchField" promptText="🔍 Rechercher par titre..." styleClass="search-field" prefWidth="350" />
            <ComboBox fx:id="levelFilter" promptText="Niveau" prefWidth="130" />
            <ComboBox fx:id="statusFilter" promptText="Statut" prefWidth="130" />
            <Button onAction="#handleRefresh" text="🔄 Actualiser" styleClass="btn-secondary" />
        </HBox>
    </VBox>

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="📚 Toutes les Formations" closable="false">
                <VBox spacing="15.0" style="-fx-padding: 20;">
                    <TableView fx:id="tableFormations" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colTitle" text="Titre" prefWidth="220"/>
                            <TableColumn fx:id="colLevel" text="Niveau" prefWidth="100"/>
                            <TableColumn fx:id="colDuration" text="Durée (h)" prefWidth="100"/>
                            <TableColumn fx:id="colPrice" text="Prix" prefWidth="100"/>
                            <TableColumn fx:id="colApproved" text="Approuvée" prefWidth="100"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune formation trouvée." style="-fx-text-fill: #999; -fx-font-size: 14px;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="⭐ Mes Formations" closable="false">
                <VBox spacing="15.0" style="-fx-padding: 20;">
                    <TableView fx:id="tableMyFormations" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-padding: 10;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="myColId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="myColTitle" text="Titre" prefWidth="220"/>
                            <TableColumn fx:id="myColLevel" text="Niveau" prefWidth="100"/>
                            <TableColumn fx:id="myColDuration" text="Durée (h)" prefWidth="100"/>
                            <TableColumn fx:id="myColPrice" text="Prix" prefWidth="100"/>
                            <TableColumn fx:id="myColApproved" text="Approuvée" prefWidth="100"/>
                            <TableColumn fx:id="myColActions" text="Actions" prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="Vous n'avez aucune formation pour le moment." style="-fx-text-fill: #999; -fx-font-size: 14px;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>

</VBox>
