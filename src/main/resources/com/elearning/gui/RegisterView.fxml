<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.canvas.Canvas?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.elearning.controller.RegisterController"
           styleClass="login-root">

    <HBox alignment="CENTER" spacing="0">

        <!-- Panneau gauche : visuel décoratif -->
        <VBox alignment="CENTER" spacing="20"
              prefWidth="420" prefHeight="600"
              style="-fx-background-color: linear-gradient(to bottom, #1e3a5f, #2980b9); -fx-padding: 50;">

            <!-- Logo -->
            <ImageView fitWidth="180" preserveRatio="true">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>
            <Label text="Eduverse" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Plateforme e-Learning"
                   style="-fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.75);"/>

            <Region prefHeight="1" prefWidth="80"
                    style="-fx-background-color: rgba(255,255,255,0.3);"/>

            <Label text="&quot;Apprendre sans jamais cesser&quot;"
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.6); -fx-font-style: italic;"/>

            <HBox spacing="20" alignment="CENTER">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="500+" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    <Label text="Étudiants" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="50+" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                    <Label text="Cours" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="20+" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <Label text="Instructeurs" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Panneau droit : formulaire d'inscription -->
        <VBox spacing="15" alignment="CENTER"
              prefWidth="480" styleClass="login-card">

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Inscription" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Rejoins Eduverse dès maintenant" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <Region prefHeight="1" maxWidth="Infinity" styleClass="login-divider"/>

            <Label fx:id="errorLabel" styleClass="login-error" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>
            <Label fx:id="successLabel" text="✅ Inscription réussie ! En attente de validation." style="-fx-text-fill: #2ecc71; -fx-background-color: #eafaf1; -fx-padding: 10; -fx-background-radius: 5;" wrapText="true" maxWidth="Infinity" visible="false" managed="false"/>

            <VBox spacing="6">
                <Label text="NOM COMPLET" styleClass="login-field-label"/>
                <TextField fx:id="fullNameField" promptText="Votre nom complet" styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="ADRESSE E-MAIL" styleClass="login-field-label"/>
                    <Label fx:id="labelEmailBadge" text="🌐 Vérification..."
                           style="-fx-font-size: 10px; -fx-background-color: #ecf0f1; -fx-padding: 2 6; -fx-background-radius: 4; -fx-text-fill: #95a5a6;"
                           visible="false" managed="false"/>
                </HBox>
                <TextField fx:id="emailField" promptText="votre@email.tn" styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="MOT DE PASSE" styleClass="login-field-label"/>
                    <Button text="Générer" onAction="#handleGenererMotDePasse" style="-fx-font-size: 10px; -fx-background-color: #ecf0f1; -fx-padding: 2 6; -fx-cursor: hand;"/>
                </HBox>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="login-field" maxWidth="Infinity"/>
                <!-- Indicateur de force -->
                <ProgressBar fx:id="passwordStrengthBar"
                             maxWidth="Infinity" prefHeight="6"
                             progress="0"
                             style="-fx-accent: #e74c3c;"/>
                <Label fx:id="passwordStrengthLabel" text=""
                       style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="CONFIRMER" styleClass="login-field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="login-field" maxWidth="Infinity"/>
            </VBox>

            <!-- IMPORTANT: Rôles -->
            <HBox fx:id="roleHBox" spacing="20" alignment="CENTER_LEFT">
                <Label text="JE SUIS :" styleClass="login-field-label"/>
                <RadioButton fx:id="radioEtudiant" text="Étudiant" userData="ETUDIANT"/>
                <RadioButton fx:id="radioEnseignant" text="Enseignant" userData="ENSEIGNANT"/>
            </HBox>

            <!-- CAPTCHA mathématique -->
            <VBox spacing="6">
                <Label text="VÉRIFICATION ANTI-BOT" styleClass="login-field-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Canvas fx:id="captchaCanvas" width="220" height="60"
                            style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 4, 0, 0, 2); -fx-background-radius: 8;"/>
                    <TextField fx:id="captchaField"
                               promptText="Réponse"
                               styleClass="login-field"
                               prefWidth="100"/>
                </HBox>
                <Label fx:id="errCaptcha" text=""
                       style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"
                       visible="false" managed="false" wrapText="true"/>
            </VBox>

            <Button fx:id="btnRegister" text="📝  S'inscrire"
                    styleClass="login-btn" maxWidth="Infinity"
                    onAction="#handleRegister"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Déjà un compte ?" style="-fx-text-fill: #7f8c8d;"/>
                <Hyperlink text="Se connecter" onAction="#allerVersLogin" 
                           style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-underline: true;"/>
            </HBox>
        </VBox>
    </HBox>
</StackPane>
