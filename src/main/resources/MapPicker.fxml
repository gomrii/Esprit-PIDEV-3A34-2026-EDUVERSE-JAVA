<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.MapPickerController">
   <children>
      <AnchorPane VBox.vgrow="ALWAYS">
         <children>
            <WebView fx:id="webView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
      </AnchorPane>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #f3f4f6;">
         <children>
            <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="btn-secondary" stylesheets="@css/style.css" text="Annuler" />
            <Button mnemonicParsing="false" onAction="#handleConfirm" styleClass="btn-success" stylesheets="@css/style.css" text="Confirmer ce lieu" />
         </children>
         <padding>
            <Insets bottom="15.0" left="15.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
   </children>
</VBox>
