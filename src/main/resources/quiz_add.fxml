<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.Controller.AjouterQuizController"
            style="-fx-padding: 20;">
    
    <VBox spacing="15" style="-fx-alignment: center;">
        <Label text="Ajouter un Quiz" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        
        <HBox spacing="10">
            <Label text="Titre:" style="-fx-min-width: 100;"/>
            <TextField fx:id="titreTF" style="-fx-min-width: 300;"/>
        </HBox>
        
        <HBox spacing="10" style="-fx-padding-top: 20;">
            <Button text="Enregistrer" onAction="#ajouterQuiz" styleClass="primary-button"/>
            <Button text="Annuler" onAction="#handleBack" styleClass="secondary-button"/>
        </HBox>
    </VBox>
</AnchorPane>