<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.StudentQuizPassController" styleClass="app-shell">

<center>
        <VBox styleClass="main-content dashboard-surface">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <HBox styleClass="dashboard-topbar">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-eyebrow" text="Session de quiz"/>
                    <Label fx:id="quizTitleLabel" styleClass="page-title" text="Passage du quiz"/>
                    <Label styleClass="page-subtitle" text="Travaillez question par question, gardez un oeil sur le chronometre et soumettez votre reponse finale en toute clarte." wrapText="true"/>
                </VBox>
                <HBox spacing="12" styleClass="student-session-aside">
                    <VBox styleClass="profile-chip profile-chip-compact session-progress-chip">
                        <Label styleClass="profile-chip-title" text="Progression"/>
                        <Label fx:id="progressLabel" styleClass="profile-chip-subtitle session-progress-value" text="Question 0 / 0"/>
                    </VBox>
                    <VBox styleClass="profile-chip profile-chip-wide session-timer-card">
                        <Label styleClass="profile-chip-title" text="Chronometre"/>
                        <Label fx:id="timerLabel" styleClass="session-timer" text="Temps restant : 00:00"/>
                    </VBox>
                </HBox>
            </HBox>

            <VBox spacing="16" styleClass="session-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="field-label" text="Question en cours"/>
                    <Label fx:id="metaLabel" styleClass="session-meta-chip" text="Niveau : - | Duree : 0 min"/>
                </HBox>
                <Label fx:id="questionLabel" styleClass="session-question" text="Question" wrapText="true"/>
                <HBox spacing="10" styleClass="translation-action-row session-translation-row">
                    <Button fx:id="translateEnButton" onAction="#handleTranslateEn" styleClass="btn-translate-en" text="Traduire EN"/>
                    <Button fx:id="translateFrButton" onAction="#handleTranslateFr" styleClass="btn-translate-fr" text="Traduire FR"/>
                </HBox>
                <ScrollPane fitToWidth="true" styleClass="content-scroll session-answers-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="answersBox" spacing="12" styleClass="session-answers-box">
                            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="session-footer-actions">
                <Button fx:id="prevButton" onAction="#handlePrevious" styleClass="btn-secondary" text="Precedent"/>
                <Button fx:id="nextButton" onAction="#handleNext" styleClass="btn-primary" text="Suivant"/>
                <Button fx:id="submitButton" onAction="#handleSubmit" styleClass="btn-success" text="Soumettre"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>

