<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #F4F7FB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.HistoriqueController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Mon Historique d'Apprentissage" textFill="#3c3362">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label text="Retrouvez ici tous les cours que vous avez consultés récemment." textFill="#636e72">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <TableView fx:id="tableHistorique" prefHeight="400.0" prefWidth="740.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colTitre" prefWidth="450.0" text="Titre du Cours" />
                        <TableColumn fx:id="colDate" prefWidth="280.0" text="Date de consultation" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Button mnemonicParsing="false" onAction="#retourListe" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #3c3362; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;" text="Retour aux cours" />
            </children>
        </VBox>
    </children>
</AnchorPane>