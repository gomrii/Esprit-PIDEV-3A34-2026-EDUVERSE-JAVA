<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.Controller.TeacherAjouterReponseController"
            style="-fx-padding: 20;">
    
    <VBox spacing="15" style="-fx-alignment: center;">
        <Label text="Ajouter une Réponse" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        
        <HBox spacing="10">
            <Label text="Réponse:" style="-fx-min-width: 100;"/>
            <TextArea fx:id="reponseTA" style="-fx-min-width: 400; -fx-min-height: 100;"/>
        </HBox>
        
        <HBox spacing="10">
            <Label text="Score:" style="-fx-min-width: 100;"/>
            <TextField fx:id="scoreTF" style="-fx-min-width: 300;"/>
        </HBox>
        
        <HBox spacing="10" style="-fx-padding-top: 20;">
            <Button text="Enregistrer" onAction="#ajouterReponse" styleClass="primary-button"/>
            <Button text="Annuler" onAction="#handleBack" styleClass="secondary-button"/>
        </HBox>
    </VBox>
</AnchorPane>