<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="700.0" prefWidth="1050.0" spacing="20" style="-fx-background-color: #F4F7FB; -fx-padding: 25;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RecommandationController">

    <VBox prefHeight="120.0" style="-fx-background-color: linear-gradient(to right, #2D1B4E, #5D4B8E); -fx-background-radius: 20; -fx-padding: 25;">
        <HBox alignment="CENTER_LEFT" spacing="20">
            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 10;">
                <Label text="🎓" style="-fx-font-size: 26;"/>
            </StackPane>
            <VBox spacing="5">
                <Label text="RECOMMANDATIONS PERSONNALISÉES" textFill="WHITE" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
                <Label text="Découvrez les cours adaptés à votre profil et à vos objectifs" textFill="#DCDCDC" style="-fx-font-size: 13;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Retour au catalogue" onAction="#handleRetour"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-color: white; -fx-border-radius: 25;"/>
        </HBox>
    </VBox>

    <HBox spacing="30" VBox.vgrow="ALWAYS">
        <VBox prefWidth="320.0" spacing="20">
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                <Label text="👤 VOTRE PROFIL" style="-fx-font-weight: bold; -fx-text-fill: #3F3D56; -fx-font-size: 14;"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Rectangle fx:id="rectAvatar" width="70" height="70" arcWidth="20" arcHeight="20" fill="#3F3D56"/>
                    <VBox spacing="2">
                        <Label text="Étudiant" textFill="GRAY" style="-fx-font-size: 11;"/>
                        <Label fx:id="lblNomCandidat" text="Chargement..." style="-fx-font-weight: bold; -fx-font-size: 17;"/>
                    </VBox>
                </HBox>
                <VBox spacing="8" style="-fx-background-color: #F8F9FA; -fx-padding: 15; -fx-background-radius: 15;">
                    <Label fx:id="lblStatsCours" text="Cours suivis: --" style="-fx-font-size: 13; -fx-text-fill: #555;"/>
                    <Label text="📊 Niveau estimé: Intermédiaire" style="-fx-font-size: 13; -fx-text-fill: #555;"/>
                </VBox>
                <VBox spacing="8">
                    <HBox>
                        <Label text="Progression du catalogue" style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblPercent" text="0%" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                    </HBox>
                    <ProgressBar fx:id="progressGlobal" progress="0.0" maxWidth="Infinity" prefHeight="10.0" style="-fx-accent: #A3E4D7;"/>
                </VBox>
            </VBox>

            <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);">
                <Label text="📖 COURS DÉJÀ SUIVIS" style="-fx-font-weight: bold; -fx-text-fill: #3F3D56;"/>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="listeHistorique" spacing="10" />
                </ScrollPane>
            </VBox>
        </VBox>

        <VBox spacing="20" HBox.hgrow="ALWAYS">
            <HBox alignment="BOTTOM_LEFT">
                <Label text="✨ RECOMMANDATIONS POUR VOUS" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2D1B4E;"/>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="containerCards" spacing="18" style="-fx-padding: 5;"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>