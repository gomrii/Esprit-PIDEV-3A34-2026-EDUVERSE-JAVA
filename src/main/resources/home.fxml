<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.Controller.HomeController">
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Gestion Quiz - Choix du Rôle" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    
    <center>
        <VBox spacing="20" style="-fx-padding: 40; -fx-alignment: center;">
            <HBox spacing="30" style="-fx-alignment: center;">
                <Button text="Espace Enseignant" onAction="#openTeacherSpace" 
                        style="-fx-font-size: 16; -fx-padding: 15; -fx-min-width: 200;"
                        styleClass="primary-button"/>
                <Button text="Espace Admin" onAction="#openAdminSpace" 
                        style="-fx-font-size: 16; -fx-padding: 15; -fx-min-width: 200;"
                        styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>