<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.connexion3a36.Controller.ModifierQuizController"
            style="-fx-padding: 20;">

    <VBox spacing="15" style="-fx-alignment: top-center;">
        <Label text="Modifier un Quiz" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10">
            <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="idLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Titre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="titreTF" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-min-width: 300;"/>

            <Label text="Statut :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="statutLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>

            <Label text="Créé par :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="createdByLabel" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold;"/>
        </GridPane>

        <HBox spacing="10" style="-fx-padding-top: 20;">
            <Button fx:id="saveButton" text="Enregistrer" onAction="#modifierQuiz" styleClass="primary-button"/>
            <Button text="Annuler" onAction="#handleBack" styleClass="secondary-button"/>
        </HBox>
    </VBox>
</AnchorPane>
