# ============================================================================
# Git Ignore - Fichiers sensibles à ne PAS commiter
# ============================================================================

# 🔐 Configuration API (clés sensibles)
config/api.properties
config/.env
config/.env.local
.env

# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Maven
target/
*.jar
*.war
*.zip

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Dépendances
dependency-reduced-pom.xml

# Fichiers temporaires
*.tmp
*.bak
.cache/

# Fichiers de test
test-output/
test-results/

# Node modules (si utilisé)
node_modules/
package-lock.json
yarn.lock

# Fichiers de build
build/
dist/
out/

# IDE spécifiques
.vscode/settings.json
.idea/vcs.xml

# ============================================================================
# IMPORTANT : Ne pas commiter les fichiers suivants
# ============================================================================
# - Clés API Stripe (sk_*, pk_*, whsec_*)
# - Clés API Groq (gsk_*)
# - Mots de passe de base de données
# - Certificats SSL/TLS
# - Credentials d'accès
# ============================================================================
